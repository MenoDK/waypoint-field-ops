# Copy to .env, or run `make env`, which does it for you with fresh random values.
# Every value below is a placeholder. None of them is, or ever was, a real credential.

# --- database --------------------------------------------------------------------------------------------------------
# Password of the schema owner. Only the one-shot `migrate` job and the database container see it.
DB_PASSWORD=replace-with-a-long-random-string
# Password of `app_user`, the unprivileged role the API and the worker run as. It can read and write the working tables,
# but only SELECT and INSERT on the position history, and it cannot alter the schema.
APP_DB_PASSWORD=replace-with-another-long-random-string

# --- signing keys (openssl rand -hex 32) ----------------------------------------------------------------------------
# Signs the access tokens. At least 32 characters.
JWT_SECRET=replace-with-64-random-hex-characters-from-openssl-rand
# Signs the trip-sheet download links. A different key from the one above on purpose: leaking one must not forge the other.
SIGNED_URL_SECRET=replace-with-another-64-random-hex-characters

# --- the lab (demonstration only; the API refuses all of this when NODE_ENV=production) -----------------------------
# The password of the invented demo accounts (dispatchers and drivers at *.example.test) and the simulated phones.
DEMO_PASSWORD=replace-with-a-demo-password

# --- optional ---------------------------------------------------------------------------------------------------------
# When set (16+ characters), GET /metrics needs "Authorization: Bearer <token>". Unset: /metrics is open outside production
# and does not exist (404) in production.
METRICS_TOKEN=
