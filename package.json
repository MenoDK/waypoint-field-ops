{
  "name": "waypoint-field-ops",
  "version": "0.1.0",
  "description": "Reference field-operations backend: offline-tolerant GPS ingest on PostGIS, honest ETAs, alerts that fire when a phone goes quiet, a capacity-aware dispatch queue and a live map.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/database/migrate-cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "site-syntax": "node scripts/check-site-syntax.mjs",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm site-syntax && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "helmet": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0"
    }
  }
}
